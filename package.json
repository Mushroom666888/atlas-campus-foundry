{
  "name": "campus-ai-app-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "research": "node scripts/research.mjs",
    "dev": "npm run build && tsx scripts/start-local.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "start": "tsx server/main.ts",
    "verify-integrations": "tsx scripts/verify-integrations.ts",
    "verify-docker": "tsx scripts/verify-docker.ts",
    "verify-postgres": "tsx scripts/verify-postgres.ts",
    "verify-recovery": "tsx scripts/verify-recovery.ts",
    "backup": "tsx scripts/backup.ts",
    "verify-backup": "tsx --test tests/backup.test.ts",
    "verify-live-agent": "tsx scripts/verify-live-agent.ts",
    "complete-connected": "tsx scripts/acceptance.ts --connected",
    "acceptance": "tsx scripts/acceptance.ts",
    "lint": "eslint .",
    "format": "prettier --write server packages web tests scripts *.ts *.json",
    "check": "npm run lint && npm run build && npm test",
    "final-e2e": "npm run check && npm run e2e",
    "deploy-local": "tsx scripts/showcase.ts",
    "deploy-visual": "tsx scripts/visual-showcase.ts",
    "deploy-commerce": "tsx scripts/commercial-showcase.ts",
    "reuse-report": "tsx scripts/reuse-report.ts",
    "image:build": "docker build -t campus-foundry:local .",
    "deploy": "docker compose up --build -d"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@xyflow/react": "^12.12.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "lucide-react": "^1.54.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
