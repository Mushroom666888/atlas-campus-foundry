# Copy values locally; never send credentials in chat.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# Empty uses durable embedded PostgreSQL (PGlite), not a mock.
DATABASE_URL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_STEPS=18
# local-trusted executes only platform-owned runtime; generated code requires Docker.
DEPLOYMENT_PROVIDER=local-trusted
FOUNDRY_IMAGE=campus-foundry:local
PUBLIC_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
EMAIL_PROVIDER=local-outbox
SMTP_URL=
EMAIL_FROM=
STORAGE_PROVIDER=local
# Production registration defaults closed. Local development allows account creation.
ALLOW_REGISTRATION=true
# Leave disabled until a dedicated runner and independent HTTPS app domain are reviewed.
ENABLE_CUSTOM_CODE=false
APP_DOMAIN=
